# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/
gup
/testproxy
dist
cover.*
/completions

cmd/testdata/gobin_tmp

# `make coverage` scratch: raw covdata (unit + e2e) and the merged dir. The
# final cover.out / cover.html are the only kept artifacts.
.coverage/

# Hugo build output and cache for the documentation website (built by
# `make website`, published from CI).
/website/public/
/website/resources/
/website/.hugo_build.lock

# gup's own state locks. They are never deleted -- unlinking a lock file another
# gup may already have opened is what would let two processes lock two different
# files at one path -- so a test that points $GOBIN at a directory in the tree
# leaves an empty one behind.
.gup.lock
gup.json.lock
